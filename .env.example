# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Port the Node process listens on. Nginx (or Hostinger's proxy) forwards to this.
PORT=3000

# Admin login (see README "Admin password" section for how to generate the hash).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Long random string used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

NODE_ENV=production

# Set to true only once the site is actually served over HTTPS (otherwise the
# admin cookie won't be sent and login will silently fail).
TRUST_HTTPS=false
